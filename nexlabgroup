<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Nexlab Group | Artist Management</title>
  <style>
    /* ---------- RESET & GLOBAL ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #ffffff;
      color: #111111;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.5;
      scroll-behavior: smooth;
    }

    /* Tipografía en grises */
    h1, h2, h3, p, a, button {
      letter-spacing: -0.02em;
    }

    h2 {
      font-size: 2.2rem;
      font-weight: 600;
      margin-bottom: 2rem;
      border-bottom: 2px solid #000000;
      display: inline-block;
      padding-bottom: 6px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ---------- HEADER / NAV ---------- */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 28px 0;
      border-bottom: 1px solid #e5e5e5;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      text-decoration: none;
      color: #000000;
    }

    .logo span {
      font-weight: 400;
      color: #444444;
    }

    .nav-links {
      display: flex;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      font-weight: 500;
      color: #222222;
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: #777777;
    }

    /* ---------- HERO ---------- */
    .hero {
      padding: 100px 0 80px;
      text-align: center;
    }

    .hero h1 {
      font-size: 3.6rem;
      font-weight: 700;
      margin-bottom: 20px;
      line-height: 1.2;
    }

    .hero .tagline {
      font-size: 1.3rem;
      color: #3a3a3a;
      max-width: 650px;
      margin: 0 auto;
    }

    /* Botón estilo B&W */
    .btn {
      display: inline-block;
      margin-top: 32px;
      padding: 12px 32px;
      background-color: #000000;
      color: #ffffff;
      text-decoration: none;
      font-weight: 500;
      border: 1px solid #000000;
      transition: all 0.25s ease;
    }

    .btn:hover {
      background-color: #ffffff;
      color: #000000;
    }

    /* ---------- WHO I AM / WHAT I DO ---------- */
    .section {
      padding: 70px 0;
      border-bottom: 1px solid #ececec;
    }

    .two-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      margin-top: 20px;
    }

    .bio-text p {
      font-size: 1.1rem;
      margin-bottom: 18px;
      color: #2c2c2c;
    }

    .services-list {
      list-style: none;
    }

    .services-list li {
      font-size: 1.1rem;
      margin-bottom: 18px;
      padding-left: 24px;
      position: relative;
      font-weight: 450;
    }

    .services-list li::before {
      content: "—";
      position: absolute;
      left: 0;
      color: #333;
    }

    /* ---------- ARTISTS GRID ---------- */
    .artists-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 48px;
      margin-top: 32px;
    }

    .artist-card {
      text-align: center;
      transition: transform 0.2s ease;
    }

    .artist-card:hover {
      transform: translateY(-6px);
    }

    .artist-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      background-color: #eaeaea;
      object-fit: cover;
      filter: grayscale(100%);
      transition: filter 0.3s ease;
      margin-bottom: 20px;
    }

    .artist-card:hover .artist-img {
      filter: grayscale(40%);
    }

    .artist-card h3 {
      font-size: 1.6rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .artist-card p {
      color: #3f3f3f;
      font-size: 0.95rem;
      line-height: 1.4;
      max-width: 260px;
      margin: 0 auto;
    }

    /* ----- footer ----- */
    footer {
      padding: 50px 0 40px;
      text-align: center;
      color: #5a5a5a;
      background-color: #fafafa;
      border-top: 1px solid #ddd;
    }

    footer p {
      margin-top: 8px;
    }

    /* ----- responsive ----- */
    @media (max-width: 768px) {
      .navbar {
        flex-direction: column;
        gap: 16px;
      }
      .hero h1 {
        font-size: 2.5rem;
      }
      .two-columns {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      h2 {
        font-size: 1.8rem;
      }
      .artists-grid {
        gap: 32px;
      }
    }
  </style>
</head>
<body>

<header>
  <div class="container">
    <nav class="navbar">
      <a href="#" class="logo">NEXLAB<span> GROUP</span></a>
      <ul class="nav-links">
        <li><a href="#who">Who I am</a></li>
        <li><a href="#what">What I do</a></li>
        <li><a href="#artists">Artists</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>Artist Manager<br>Nexlab Group</h1>
      <div class="tagline">Elevating talent. Building legacies. Monochrome focus.</div>
      <a href="#artists" class="btn">Discover artists</a>
    </div>
  </section>

  <!-- Who I am + What I do -->
  <section id="who" class="section">
    <div class="container">
      <div class="two-columns">
        <div class="bio-text">
          <h2>Who I am</h2>
          <p>I’m the founder of Nexlab Group — a talent-first artist management agency based between NYC and London. With over a decade of experience in music & creative industries, I’ve dedicated my career to shaping authentic careers, not just moments.</p>
          <p>My approach is minimal, sharp and built on trust. I don’t believe in clutter — only meaningful partnerships and long-term vision.</p>
        </div>
        <div>
          <h2>What I do</h2>
          <ul class="services-list">
            <li>360 Artist Management & Development</li>
            <li>Strategic Brand Partnerships</li>
            <li>Label Relations & A&R Consulting</li>
            <li>Global Tour & Booking Strategy</li>
            <li>Creative Direction (Visual / Identity)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Artists Section (representados) -->
  <section id="artists" class="section">
    <div class="container">
      <h2>Artists I represent</h2>
      <div class="artists-grid" id="artistsGrid">
        <!-- Los artistas se agregarán dinámicamente con JS (o estático) -->
      </div>
    </div>
  </section>

  <!-- Contact minimal -->
  <section id="contact" class="section" style="border-bottom: none;">
    <div class="container" style="text-align: center;">
      <h2>Work with me</h2>
      <p style="max-width: 500px; margin: 0 auto 24px auto; color: #2b2b2b;">Interested in management, collaborations or just a conversation — reach out.</p>
      <a href="mailto:hello@nexlabgroup.com" class="btn">hello@nexlabgroup.com</a>
    </div>
  </section>
</main>

<footer>
  <div class="container">
    <p>© 2025 Nexlab Group — Artist Management. All works in monochrome.</p>
  </div>
</footer>

<script>
  // DATOS DE ARTISTAS (nombre + breve descripción)
  // Puedes editar, agregar o eliminar aquí.
  const artistsData = [
    {
      name: "Aria Noctis",
      bio: "Alternative R&B / electronic songwriting. Debut EP 'Shades' surpassed 5M streams.",
      imgPlaceholder: "https://placehold.co/600x600/e0e0e0/444444?text=AN" // en producción usarías imágenes reales
    },
    {
      name: "The Velvet Stripes",
      bio: "Indie rock trio with raw energy and poetic lyrics. Tours across EU & UK.",
      imgPlaceholder: "https://placehold.co/600x600/d0d0d0/333333?text=TVS"
    },
    {
      name: "Mila Céline",
      bio: "French pop experimentalist. Blending jazz, electro & soul. New album 2025.",
      imgPlaceholder: "https://placehold.co/600x600/cacaca/2b2b2b?text=MC"
    },
    {
      name: "Kosmo K.",
      bio: "Producer / DJ pushing deep house & melodic techno. Resident at fabric London.",
      imgPlaceholder: "https://placehold.co/600x600/b8b8b8/252525?text=KK"
    }
  ];

  // Función para crear las tarjetas de artistas (en blanco y negro puro)
  function renderArtists() {
    const gridContainer = document.getElementById('artistsGrid');
    if (!gridContainer) return;
    
    // Limpiar (por si acaso)
    gridContainer.innerHTML = '';
    
    artistsData.forEach(artist => {
      // crear card
      const card = document.createElement('div');
      card.className = 'artist-card';
      
      // imagen - se puede reemplazar por imágenes reales (URLs en escala de grises)
      const img = document.createElement('img');
      img.src = artist.imgPlaceholder;
      img.alt = artist.name;
      img.className = 'artist-img';
      // Para simular fotos en B&N reales, si tienes imágenes locales podes poner filter: grayscale(100%) ya en CSS
      
      const nameTitle = document.createElement('h3');
      nameTitle.textContent = artist.name;
      
      const bioP = document.createElement('p');
      bioP.textContent = artist.bio;
      
      card.appendChild(img);
      card.appendChild(nameTitle);
      card.appendChild(bioP);
      
      gridContainer.appendChild(card);
    });
  }
  
  // Smooth scroll para los enlaces internos (opcional)
  document.querySelectorAll('.nav-links a, .btn[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href');
      if(targetId && targetId !== '#') {
        const targetElement = document.querySelector(targetId);
        if(targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });

  // Ejecutar render
  renderArtists();
</script>
</body>
</html>
